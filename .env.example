# Plantilla de variables de entorno. Copie este archivo a ".env" y ajuste valores.
# NUNCA suba el archivo ".env" real a GitHub (está excluido en .gitignore).
# Todos los valores de este archivo son de ejemplo, no son credenciales reales.
HOST_PORT=8080
TZ=America/Santiago
APP_VERSION=1.0.0
# Ejemplo de secreto ficticio (solo para ilustrar el patrón de configuración):
EXAMPLE_API_TOKEN=reemplazar_por_valor_local_no_publicar
